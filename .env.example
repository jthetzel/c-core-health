# Copy to .env. Values below match the kubectl port-forwards in README.md.
CCH_PG_DSN=postgresql+psycopg://username:password@localhost:5433/holmes
CCH_PREFECT_API_URL=http://localhost:4200/api
# CCH_PREFECT_API_KEY=

# Mutating endpoints (re-run, purge) are disabled unless both are set.
CCH_ENABLE_MUTATIONS=false
# CCH_API_KEY=change-me

CCH_BACKUP_DIR=backups
# JSON list, e.g. ["http://localhost:5173"]
CCH_CORS_ORIGINS=[]
